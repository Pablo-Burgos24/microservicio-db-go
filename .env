# ── Microservicio DB Go ───────────────────────────────────────────────────────
PORT=8080
MONGO_USER=admin
MONGO_PASSWORD=password
MONGODB_URI=mongodb://admin:password@mongo:27017
MONGODB_DB=pdf_db
MONGODB_COLLECTION=extracted_texts

# ── Límites ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_IN_FLIGHT=32
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s

# ── RFC 9457 ──────────────────────────────────────────────────────────────────
ERR_BASE_URL=https://errors.example.com

# ── Red compartida (debe ser la misma en docker-compose.db.yml y docker-compose.app.yml) ─
SHARED_NETWORK_NAME=test_network

# ── Zona horaria ──────────────────────────────────────────────────────────────
TZ=America/Argentina/Buenos_Aires